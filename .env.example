# Neon Database Connection String
# Get this from your Neon Project Dashboard -> Connection Details
# Copy the connection string and paste it here
VITE_NEON_DATABASE_URL=postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# OCR.space API Key (server-side only, used by netlify/functions/ocr-fuel.js)
# Free tier: 25.000 requests/month, no credit card needed.
# Get your key at: https://ocr.space/ocrapi/freekey
# Set this in Netlify dashboard under Site settings → Environment variables (NOT in client bundle).
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
